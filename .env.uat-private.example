# I01B private-only UAT is a standalone, chain-free topology.
# Copy this file to a new operator-controlled path and replace every
# __REQUIRED_*__ marker. Never source values from .env.uat or old UAT secrets.

I01B_PRIVATE_UAT_XNODE_DIR=__REQUIRED_CANONICAL_CLEAN_XNODE_SOURCE_DIRECTORY__
I01B_PRIVATE_UAT_XNODE_DOCKERFILE=__REQUIRED_CANONICAL_REVIEWED_XNODE_XRAY_DOCKERFILE__
I01B_PRIVATE_UAT_EXPECTED_XNODE_COMMIT=__REQUIRED_EXACT_40_LOWER_HEX_XNODE_COMMIT__
I01B_PRIVATE_UAT_EXPECTED_XNODE_DOCKERFILE_SHA256=__REQUIRED_EXACT_64_LOWER_HEX_DOCKERFILE_SHA256__
I01B_PRIVATE_UAT_DOTNET_SDK_DIGEST=sha256:__REQUIRED_EXACT_64_LOWER_HEX_DOTNET_SDK_DIGEST__
I01B_PRIVATE_UAT_DOTNET_RUNTIME_DIGEST=sha256:__REQUIRED_EXACT_64_LOWER_HEX_DOTNET_RUNTIME_DIGEST__
I01B_PRIVATE_UAT_XRAY_VERSION=__REQUIRED_EXACT_REVIEWED_XRAY_VERSION__
I01B_PRIVATE_UAT_XRAY_SHA256=__REQUIRED_EXACT_64_LOWER_HEX_XRAY_ARCHIVE_SHA256__
I01B_PRIVATE_UAT_NODE_IMAGE_DIGEST=sha256:__REQUIRED_EXACT_64_LOWER_HEX_NODE_IMAGE_DIGEST__
I01B_PRIVATE_UAT_EXPECTED_DEVOPS_COMMIT=__REQUIRED_EXACT_40_LOWER_HEX_DEVOPS_COMMIT__
I01B_PRIVATE_UAT_EXPECTED_COMPAT_CONTENT_SHA256=__REQUIRED_EXACT_64_LOWER_HEX_COMPAT_BUILD_CONTENT_SHA256__

I01B_PRIVATE_UAT_NODE_1_ROUTER_ID=__REQUIRED_FRESH_NODE_1_64_HEX_ED25519_PUBLIC_ID__
I01B_PRIVATE_UAT_NODE_2_ROUTER_ID=__REQUIRED_FRESH_NODE_2_64_HEX_ED25519_PUBLIC_ID__
I01B_PRIVATE_UAT_NODE_3_ROUTER_ID=__REQUIRED_FRESH_NODE_3_64_HEX_ED25519_PUBLIC_ID__

I01B_PRIVATE_UAT_NODE_1_ED25519_SECRET_FILE=./secret-templates/uat-private-i01b/node-1-ed25519.seed.example
I01B_PRIVATE_UAT_NODE_2_ED25519_SECRET_FILE=./secret-templates/uat-private-i01b/node-2-ed25519.seed.example
I01B_PRIVATE_UAT_NODE_3_ED25519_SECRET_FILE=./secret-templates/uat-private-i01b/node-3-ed25519.seed.example
