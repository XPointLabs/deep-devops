# Copy to an operator-controlled, ignored path. Do not run Compose with this
# example: every __REQUIRED_*__ marker must be replaced first.
#
# 127.0.0.1 keeps the direct developer lane host-local. For a trusted LAN UAT
# host, set both values to that host's canonical LAN IPv4 address.
FIRST_RELEASE_BIND_HOST=127.0.0.1
FIRST_RELEASE_PUBLIC_HOST=127.0.0.1
FIRST_RELEASE_MASK_DOMAIN=__REQUIRED_REVIEWED_REALITY_MASK_DOMAIN__

# The compose defaults pin the current local protocol cutover package set.
# Override all three values together only after regenerating and reviewing the
# XNode local-protocol-cutover manifest, packages and lock files.
# FIRST_RELEASE_DEEP_PROTOCOL_PACKAGE_VERSION=0.6.0-local.2ee5f72df11c
# FIRST_RELEASE_DEEP_PROTOCOL_PACKAGE_SHA256=bc76d6748a1910a90bfd7544f2e0da2b73d83dc297171a3a2ec6ccb6f0c45c86
# FIRST_RELEASE_DEEP_PROTOCOL_MEMBERSHIP_ROUTES_PACKAGE_SHA256=09968cb919f33cc7ecdedb6e70f27c6be2ba5f2d9b3dd19092292323779d51d3

# Public identities and protected file paths. Router IDs must be the Ed25519
# public IDs derived from the corresponding seed files. X25519 scalars must be
# independently generated. Files are mounted read-only and are never copied
# into the image.
FIRST_RELEASE_XNODE_1_ROUTER_ID=__REQUIRED_64_LOWER_HEX_ED25519_PUBLIC_ID__
FIRST_RELEASE_XNODE_2_ROUTER_ID=__REQUIRED_64_LOWER_HEX_ED25519_PUBLIC_ID__
FIRST_RELEASE_XNODE_3_ROUTER_ID=__REQUIRED_64_LOWER_HEX_ED25519_PUBLIC_ID__
FIRST_RELEASE_XNODE_1_ED25519_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_2_ED25519_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_3_ED25519_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_1_X25519_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_2_X25519_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_3_X25519_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__

# Each path must contain a different raw 32-byte key. These protect only the
# node-local ONION replay, entropy and opaque-key-vault state; they are not
# Ed25519/X25519 identity material.
FIRST_RELEASE_XNODE_1_ONION_STATE_PROTECTION_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__
FIRST_RELEASE_XNODE_2_ONION_STATE_PROTECTION_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__
FIRST_RELEASE_XNODE_3_ONION_STATE_PROTECTION_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__

# Public BLS registration artifacts. The local stack does not derive or retain
# BLS private scalars. Supply reviewed public keys and proof-of-possession
# signatures for the selected local chain/domain binding.
FIRST_RELEASE_XNODE_1_BLS_PUBLIC_KEY=__REQUIRED_256_LOWER_HEX__
FIRST_RELEASE_XNODE_2_BLS_PUBLIC_KEY=__REQUIRED_256_LOWER_HEX__
FIRST_RELEASE_XNODE_3_BLS_PUBLIC_KEY=__REQUIRED_256_LOWER_HEX__
FIRST_RELEASE_XNODE_1_BLS_SIGNATURE=__REQUIRED_512_LOWER_HEX__
FIRST_RELEASE_XNODE_2_BLS_SIGNATURE=__REQUIRED_512_LOWER_HEX__
FIRST_RELEASE_XNODE_3_BLS_SIGNATURE=__REQUIRED_512_LOWER_HEX__

# One VLESS/Reality identity per XNode. Client IDs and private Reality keys are
# protected files mounted read-only; Compose receives paths only.
FIRST_RELEASE_XNODE_1_VLESS_CLIENT_ID_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_2_VLESS_CLIENT_ID_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_3_VLESS_CLIENT_ID_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_1_REALITY_PUBLIC_KEY=__REQUIRED_XRAY_X25519_PUBLIC_KEY__
FIRST_RELEASE_XNODE_2_REALITY_PUBLIC_KEY=__REQUIRED_XRAY_X25519_PUBLIC_KEY__
FIRST_RELEASE_XNODE_3_REALITY_PUBLIC_KEY=__REQUIRED_XRAY_X25519_PUBLIC_KEY__
FIRST_RELEASE_XNODE_1_REALITY_PRIVATE_KEY_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_2_REALITY_PRIVATE_KEY_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_3_REALITY_PRIVATE_KEY_FILE=__REQUIRED_ABSOLUTE_PROTECTED_FILE__
FIRST_RELEASE_XNODE_1_REALITY_SHORT_ID=__REQUIRED_16_LOWER_HEX__
FIRST_RELEASE_XNODE_2_REALITY_SHORT_ID=__REQUIRED_16_LOWER_HEX__
FIRST_RELEASE_XNODE_3_REALITY_SHORT_ID=__REQUIRED_16_LOWER_HEX__

# Registry ContactResolve production authority. The runtime provisioning script
# creates the independent integrity/witness keys and path bindings. The genesis
# authority hash is supplied only by reviewed production authoring; never use a
# DEV fixture or arbitrary bytes here.
FIRST_RELEASE_CONTACT_RESOLVE_NETWORK_ID=__REQUIRED_32_LOWER_HEX_NETWORK_ID__
FIRST_RELEASE_CONTACT_RESOLVE_TRUSTED_TIME_KEY_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__
FIRST_RELEASE_CONTACT_RESOLVE_REQUEST_LEDGER_KEY_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__
FIRST_RELEASE_CONTACT_RESOLVE_ARTIFACT_STATE_KEY_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__
FIRST_RELEASE_CONTACT_RESOLVE_ARTIFACT_ROOT=__REQUIRED_ABSOLUTE_PROTECTED_DIRECTORY__
FIRST_RELEASE_CONTACT_RESOLVE_OPERATOR_ROOT=__REQUIRED_ABSOLUTE_PROTECTED_DIRECTORY__
FIRST_RELEASE_CONTACT_RESOLVE_WITNESS_1_ID=__REQUIRED_64_LOWER_HEX_WITNESS_ID__
FIRST_RELEASE_CONTACT_RESOLVE_WITNESS_2_ID=__REQUIRED_64_LOWER_HEX_WITNESS_ID__
FIRST_RELEASE_CONTACT_RESOLVE_WITNESS_3_ID=__REQUIRED_64_LOWER_HEX_WITNESS_ID__
FIRST_RELEASE_CONTACT_RESOLVE_WITNESS_1_SEED_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__
FIRST_RELEASE_CONTACT_RESOLVE_WITNESS_2_SEED_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__
FIRST_RELEASE_CONTACT_RESOLVE_WITNESS_3_SEED_FILE=__REQUIRED_ABSOLUTE_PROTECTED_32_BYTE_FILE__
FIRST_RELEASE_CONTACT_RESOLVE_GENESIS_AUTHORITY_CORE_HASH=__REQUIRED_PRODUCTION_AUTHORED_XNA1_CORE_HASH__

# Optional host-port overrides. Defaults deliberately do not overlap the
# existing deep-survival-dev 418xx lane.
# FIRST_RELEASE_REGISTRY_PORT=42910
# FIRST_RELEASE_XNODE_1_API_PORT=42901
# FIRST_RELEASE_XNODE_2_API_PORT=42902
# FIRST_RELEASE_XNODE_3_API_PORT=42903
# FIRST_RELEASE_XNODE_1_VLESS_PORT=42941
# FIRST_RELEASE_XNODE_2_VLESS_PORT=42942
# FIRST_RELEASE_XNODE_3_VLESS_PORT=42943

# TLS profile only. The PEM path is consumed only when -Tls is selected.
# FIRST_RELEASE_TLS_PEM_FILE=__REQUIRED_ABSOLUTE_PROTECTED_COMBINED_PEM_FILE__
# FIRST_RELEASE_TLS_XNODE_1_PORT=43001
# FIRST_RELEASE_TLS_XNODE_2_PORT=43002
# FIRST_RELEASE_TLS_XNODE_3_PORT=43003
# FIRST_RELEASE_TLS_REGISTRY_PORT=43010
