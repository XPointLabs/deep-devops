{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deep-pinned-integration-evidence/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "generatedAt",
    "releaseId",
    "programRevision",
    "manifestSha256",
    "contractArtifacts",
    "repositories",
    "packageFeed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "programRevision": {
      "type": "object"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contractArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "relativePath",
          "expectedSha256",
          "actualSha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "actualSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "informationalBranch",
          "expectedSha",
          "actualSha",
          "checkoutPath",
          "clean",
          "evidenceStatus"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "informationalBranch": {
            "type": "string",
            "minLength": 1
          },
          "expectedSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "actualSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "checkoutPath": {
            "type": "string",
            "minLength": 1
          },
          "clean": {
            "const": true
          },
          "evidenceStatus": {
            "const": "verified"
          }
        }
      }
    },
    "packageFeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "networkRestoreAllowed",
        "externalPublicationAllowed"
      ],
      "properties": {
        "mode": {
          "const": "offline-local-only"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "networkRestoreAllowed": {
          "const": false
        },
        "externalPublicationAllowed": {
          "const": false
        }
      }
    }
  }
}
