{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deep-pinned-multi-repo-manifest/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "programRevision",
    "packageFeed",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "programRevision": {
      "$ref": "#/$defs/programRevision"
    },
    "packageFeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "relativePath",
        "allowNetworkRestore",
        "allowExternalPublication"
      ],
      "properties": {
        "mode": {
          "const": "offline-local-only"
        },
        "relativePath": {
          "type": "string",
          "pattern": "^artifacts/packages/[A-Za-z0-9._/-]+$"
        },
        "allowNetworkRestore": {
          "const": false
        },
        "allowExternalPublication": {
          "const": false
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "branch",
          "sha",
          "contractArtifact",
          "programRevision",
          "evidenceStatus"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "contractArtifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "relativePath",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "relativePath": {
                "type": "string",
                "pattern": "^release/contracts/[A-Za-z0-9._/-]+\\.json$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "programRevision": {
            "$ref": "#/$defs/programRevision"
          },
          "evidenceStatus": {
            "enum": [
              "pinned",
              "verified"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "programRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
