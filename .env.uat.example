# Non-secret UAT configuration. Copy to .env.uat and keep the local copy ignored.
DEEP_ROOT=..
DEEP_DEVOPS_DIR=../deep-devops
DEEP_STAKING_PORTAL_DIR=../xpoint-staking-portal
STAKING_PORTAL_COMMIT_HASH=59c8b63058d87e2a9466901907a0b251c3e39048
DEEP_LAN_IP=192.168.1.44
UAT_OPERATOR_ADDRESS=0xb0cE3b1229c00d1B85c7083E31Dae531f3B352C0
UAT_REWARDS_ADDRESS=0xb0cE3b1229c00d1B85c7083E31Dae531f3B352C0

# Secret env files must be created outside Git from secret-templates/uat/*.env.example.
# Paths are resolved by Docker Compose from this repository directory.
UAT_REWARD_KEEPER_SECRET_ENV_FILE=.secrets/uat/reward-keeper.env
UAT_NODE_1_SECRET_ENV_FILE=.secrets/uat/node-1.env
UAT_NODE_2_SECRET_ENV_FILE=.secrets/uat/node-2.env
UAT_NODE_3_SECRET_ENV_FILE=.secrets/uat/node-3.env

# Keep Alchemy or another credential-bearing provider URL only in the local env.
# Never expose it through NEXT_PUBLIC_* or include it in evidence.
ARB_SEPOLIA_RPC_URL=https://example.invalid/required-private-provider
ARB_SEPOLIA_FALLBACK_RPC_URLS=https://sepolia-rollup.arbitrum.io/rpc
ARB_SEPOLIA_CHAIN_ID=421614

# Arbitrum Sepolia UAT deployment, 2026-06-11. These addresses are public.
XPNT_TOKEN_ADDRESS=0x992E6EA54d74e79cd2CEC8D9fBD101a9a105ace5
SERVICE_NODE_REWARDS_ADDRESS=0x08A5a47E67fCd18e14AdFB535e8d8644476D4197
SERVICE_NODE_CONTRIBUTION_FACTORY_ADDRESS=0x34e50278dbeDdB0F8EC7641D2304CFf4F116066b
SERVICE_NODE_CONTRIBUTION_IMPLEMENTATION_ADDRESS=0x0561C7aEee3F72a14796BD5ed5b35622eC5ef4D2
REWARD_RATE_POOL_ADDRESS=0xe055c7200aE13984fe66c2e8AaC608bC80E19D57
UAT_CONTRACT_START_BLOCK=276115489
STAKING_REQUIREMENT_ATOMIC=120000000000

# WalletConnect project id is deployment configuration and must be supplied locally.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=__REQUIRED_NOT_COMMITTED__
NEXT_PUBLIC_ENV_FLAG=prd
NEXT_PUBLIC_SITE_URL=http://192.168.1.44:28083
UAT_BROWSER_ARBITRUM_RPC_URL=/api/network/rpc/arbitrum

PRICE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
PRICE_ARBITRUM_FALLBACK_RPC_URLS=https://arb1.arbitrum.io/rpc
XPNT_UNISWAP_V3_POOL_ADDRESS=0x5d42A2b90867B813B753f5B49877Ea7c6bB2B603
XPNT_ARBITRUM_ONE_TOKEN_ADDRESS=0x63b2cdb8b0d8774f1fdca91d24803698582a079f
USDC_ARBITRUM_ONE_TOKEN_ADDRESS=0xaf88d065e77c8cc2239327c5edb3a432268e5831

# Public node identities must be replaced after the mandatory UAT key rotation.
UAT_NODE_1_ED25519_PUBLIC_KEY=__REQUIRED_AFTER_ROTATION__
UAT_NODE_2_ED25519_PUBLIC_KEY=__REQUIRED_AFTER_ROTATION__
UAT_NODE_3_ED25519_PUBLIC_KEY=__REQUIRED_AFTER_ROTATION__

UAT_INDEXER_POLL_MS=12000
UAT_INDEXER_CATCHUP_DELAY_MS=0
UAT_INDEXER_RPC_TIMEOUT_MS=30000
UAT_INDEXER_CONFIRMATIONS=2
UAT_INDEXER_BATCH_BLOCKS=1000000
UAT_INDEXER_MAX_LOG_BLOCK_RANGE=1000000
UAT_INDEXER_ALCHEMY_FAST_BACKFILL=false

UAT_REWARD_ACCRUAL_INTERVAL_SECONDS=30
UAT_REWARD_PULSE_SECONDS=120
SERVICE_NODE_HEARTBEAT_GRACE_SECONDS=120
SERVICE_NODE_DECOMMISSION_GRACE_SECONDS=300
SERVICE_NODE_LIQUIDATION_GRACE_SECONDS=600
UAT_REWARD_CHECKPOINT_INTERVAL_MS=300000
UAT_REWARD_CHECKPOINT_MIN_RELEASE_ATOMIC=1000000000
