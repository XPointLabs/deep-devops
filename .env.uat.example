# Keep Alchemy or another private provider only in server-side/backend env.
# The staking portal receives UAT_BROWSER_ARBITRUM_RPC_URL instead, so provider
# tokens are never baked into NEXT_PUBLIC_* frontend bundles.
ARB_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/<alchemy-key>
ARB_SEPOLIA_FALLBACK_RPC_URLS=https://sepolia-rollup.arbitrum.io/rpc
ARB_SEPOLIA_CHAIN_ID=421614

# Arbitrum Sepolia UAT deployment, 2026-06-11.
